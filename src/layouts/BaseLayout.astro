---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  // Override the canonical URL — defaults to the page's own URL on solcaciencia.com.
  canonicalOverride?: string;
  // Override the og:type — defaults to "website"; blog posts pass "article".
  ogType?: string;
  // Excluye la página del índice de buscadores (agregado 21 sep 2026).
  //
  // Por qué no existía y por qué importa: gracias.astro ya pasaba
  // `noindex={true}` y sesion.astro intentaba un `<head slot="head">`, pero
  // esta interface no declaraba la prop y el layout no tiene slot nombrado.
  // Astro descartaba la primera en silencio y renderizaba el segundo dentro
  // del body, donde Google ignora el meta robots. Resultado verificado en
  // producción el 21 sep 2026: las dos páginas se servían indexables, y
  // además estaban listadas en sitemap-0.xml.
  noindex?: boolean;
}

const {
  title = 'Solca · Ciencia y Consultoría — De doctorado a industria farmacéutica',
  description = 'Acompaño a profesionales de ciencias biológicas, biomédicas y de la salud en su transición de la academia a la industria farmacéutica. Libros, consultoría y recursos gratuitos.',
  ogImage = '/og-image.png',
  canonicalOverride,
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? 'https://solcaciencia.com/';

// Normalización del canonical (21 sep 2026). `trailingSlash: 'ignore'` en
// astro.config hace que /revisar-cv y /revisar-cv/ devuelvan 200 con el mismo
// contenido. Sin normalizar, cada variante se auto-canonicaliza a sí misma y
// Google las indexa como dos páginas: ocho pares duplicados detectados en GSC,
// con los clicks repartidos entre ambas.
//
// Canonical elegido: CON slash final. Es la forma que emite sitemap-blog.xml.ts
// y la que matchea las páginas que hoy ganan tráfico. Los posts del blog ya
// pasaban canonicalOverride con slash; esto arregla el resto del sitio.
//
// Excepciones sin slash: la raíz (ya lo trae) y las rutas con extensión de
// archivo (/rss.xml, /llms.txt), donde un slash rompería la URL.
const normalizePath = (pathname: string) => {
  if (pathname === '/') return pathname;
  if (pathname.endsWith('/')) return pathname;
  // Última porción con punto = archivo, no directorio.
  if (pathname.split('/').pop()?.includes('.')) return pathname;
  return `${pathname}/`;
};

const canonicalURL =
  canonicalOverride ?? new URL(normalizePath(Astro.url.pathname), siteUrl).toString();
const ogImageURL = new URL(ogImage, siteUrl).toString();
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content="Oscar Omar Solís Castro" />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph for LinkedIn / Facebook / WhatsApp previews -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:locale" content="es_ES" />

<!-- Twitter cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<!-- Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate icon" type="image/png" href="/favicon.png" />

<meta name="generator" content={Astro.generator} />

<!--
  UTM capture · P1 sprint 2026-08-18.
  Captura ?utm_source, utm_medium, utm_campaign, utm_content, utm_term de la
  URL de landing y los persiste en sessionStorage. Los forms del sitio
  (quiz-rol, revisar-cv) leen window.__utm al enviar el POST para atribución
  downstream en weekly-report. Sin cookies, sin trackers de terceros.
-->
<script is:inline>
  (function () {
    var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
    var MAX_LEN = 200;
    var STORAGE_KEY = 'solca_utm';

    function sanitize(v) {
      if (typeof v !== 'string') return null;
      var s = v.trim().toLowerCase().replace(/[\x00-\x1f\x7f]/g, '').slice(0, MAX_LEN);
      return s.length > 0 ? s : null;
    }

    try {
      var current = {};
      try {
        var raw = sessionStorage.getItem(STORAGE_KEY);
        if (raw) current = JSON.parse(raw) || {};
      } catch (_) { current = {}; }

      var params = new URLSearchParams(window.location.search);
      var updated = false;
      UTM_KEYS.forEach(function (k) {
        var val = sanitize(params.get(k));
        if (val) { current[k] = val; updated = true; }
      });

      if (updated) {
        try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(current)); } catch (_) {}
      }
      window.__utm = current;
    } catch (_) {
      window.__utm = {};
    }
  })();
</script>

<!--
  Visitas con UTM · 14 oct 2026 (sprint W42-W45).
  Registra page_viewed en /quiz-rol, /revisar-cv y artículos del blog, una vez
  por página y sesión, para medir visitas por post también fuera del simulador.
  Mismo endpoint y KV que el funnel del simulador. Sin PII.
-->
<script is:inline>
  (function () {
    try {
      var path = window.location.pathname.replace(/\/+$/, '') || '/';
      var page = null;
      if (path === '/quiz-rol') page = 'quiz-rol';
      else if (path === '/revisar-cv') page = 'revisar-cv';
      else if (path === '/vacantes') page = 'vacantes';
      else if (/^\/libros\/[^/]+$/.test(path)) page = 'libro';
      else if (/^\/blog\/[^/]+$/.test(path)) page = 'blog';
      if (!page) return;
      var seenKey = 'solca_pv:' + path;
      try {
        if (sessionStorage.getItem(seenKey)) return;
        sessionStorage.setItem(seenKey, '1');
      } catch (_) {}
      var utm = window.__utm || {};
      var body = JSON.stringify({
        event: 'page_viewed',
        page: page,
        path: path,
        utm_source: utm.utm_source,
        utm_medium: utm.utm_medium,
        utm_campaign: utm.utm_campaign,
        utm_content: utm.utm_content,
        utm_term: utm.utm_term,
        referrer: document.referrer || undefined,
      });
      if (navigator.sendBeacon) {
        navigator.sendBeacon('/api/simulator-events', new Blob([body], { type: 'application/json' }));
      } else {
        fetch('/api/simulator-events', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: body, keepalive: true }).catch(function () {});
      }
    } catch (_) {}
  })();
</script>

<!--
  Origen de ventas en Hotmart · 14 oct 2026.
  Al hacer clic en un enlace a Hotmart, agrega la etiqueta de origen que Hotmart
  muestra en Ventas > Dashboard Origen de Ventas: sck en pay.hotmart.com (página
  de pago) y src en go.hotmart.com (HotLink). Valor: "<fuente>|<campaña>" si la
  visita trae UTM, o "web|<página>" si no. Máx. 30 caracteres, sin "_" (reservado
  por Hotmart). Registra book_clicked. Delegado en document para cubrir enlaces
  que se pintan después (resultado del Quiz, reporte del simulador).
-->
<script is:inline>
  (function () {
    function clean(s) {
      return String(s || '').toLowerCase().replace(/_/g, '-').replace(/[^a-z0-9|-]/g, '');
    }
    function originTag() {
      var utm = window.__utm || {};
      var path = window.location.pathname.replace(/\/+$/, '') || '/';
      if (utm.utm_campaign || utm.utm_source) {
        var src = utm.utm_source === 'linkedin' ? 'li' : clean(utm.utm_source || 'utm').slice(0, 6);
        return (src + '|' + clean(utm.utm_campaign || '')).slice(0, 30);
      }
      var page = path === '/' ? 'home' : path.split('/').filter(Boolean).pop();
      return ('web|' + clean(page)).slice(0, 30);
    }
    document.addEventListener('click', function (e) {
      try {
        var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
        if (!a) return;
        var url = new URL(a.href, window.location.href);
        var param = url.hostname === 'pay.hotmart.com' ? 'sck' : url.hostname === 'go.hotmart.com' ? 'src' : null;
        // 30 oct 2026 (EMB-4): clic al siguiente paso entre páginas propias (CV o quiz → simulador).
        var ns = a.getAttribute('data-next-step');
        if (ns) {
          var u1 = window.__utm || {};
          var nb = JSON.stringify({
            event: 'next_step_clicked',
            product: ns.slice(0, 60),
            path: window.location.pathname,
            utm_source: u1.utm_source,
            utm_medium: u1.utm_medium,
            utm_campaign: u1.utm_campaign,
            utm_content: u1.utm_content,
            referrer: document.referrer || undefined,
          });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/simulator-events', new Blob([nb], { type: 'application/json' }));
          return;
        }
        // 30 oct 2026: clics salientes a LinkedIn y YouTube (perfil, newsletter, canal).
        if (!param && /(^|\.)(linkedin\.com|youtube\.com)$/.test(url.hostname)) {
          var u0 = window.__utm || {};
          var ob = JSON.stringify({
            event: 'outbound_clicked',
            product: (url.hostname.replace(/^www\./, '') + url.pathname).slice(0, 120),
            path: window.location.pathname,
            utm_source: u0.utm_source,
            utm_medium: u0.utm_medium,
            utm_campaign: u0.utm_campaign,
            utm_content: u0.utm_content,
            referrer: document.referrer || undefined,
          });
          if (navigator.sendBeacon) navigator.sendBeacon('/api/simulator-events', new Blob([ob], { type: 'application/json' }));
          return;
        }
        if (!param) return;
        var tag = url.searchParams.get(param) || originTag();
        if (!url.searchParams.get(param)) {
          url.searchParams.set(param, tag);
          a.href = url.toString();
        }
        var utm = window.__utm || {};
        var body = JSON.stringify({
          event: 'book_clicked',
          product: url.pathname.replace(/\//g, ''),
          tag: tag,
          path: window.location.pathname,
          utm_source: utm.utm_source,
          utm_medium: utm.utm_medium,
          utm_campaign: utm.utm_campaign,
          utm_content: utm.utm_content,
          utm_term: utm.utm_term,
          referrer: document.referrer || undefined,
        });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/simulator-events', new Blob([body], { type: 'application/json' }));
        }
      } catch (_) {}
    }, true);
  })();
</script>
</head>
<body>
<slot />
</body>
</html>
