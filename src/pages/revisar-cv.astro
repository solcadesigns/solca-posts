---
import BaseLayout from '../layouts/BaseLayout.astro';
import MarketSurvey from '../components/MarketSurvey.astro';
// 6 nov 2026: compartir la herramienta (no el resultado), discreto, debajo del formulario.
import ToolShare from '../components/ToolShare.astro';
// 2 nov 2026: textos de las casillas en src/lib/consent.ts (lo que se guarda corresponde a lo que se ve).
import { CONSENT_TEXT, CONSENT_COMMON, CONSENT_MSG, privacidadHtml } from '../lib/consent';
const consentCv = CONSENT_TEXT.cv;
const consentPrivacidadHtml = privacidadHtml('cv');
const consentErrMsg = CONSENT_MSG.privacidad_requerida;
// 6 nov 2026 (rúbrica v2): rol objetivo opcional con los 10 roles del simulador y textos del "Avísame".
import { ROLE_LABELS, ROL_NO_SEGURO, ROL_NO_SEGURO_LABEL, WAITLIST_BOTON, WAITLIST_NOTA } from '../lib/cv-review-rubric';
const roleOptions = Object.entries(ROLE_LABELS);

const cursoURL = 'https://go.hotmart.com/B104495115T';
const newsletterURL =
  'https://www.linkedin.com/build-relation/newsletter-follow?entityUrn=7432492458158120960';
const atsBlogURL =
  'https://www.linkedin.com/pulse/por-qu%C3%A9-tu-cv-pasa-filtros-ats-oscar-solis-ciencia-y-consultoria--xxlce/';
import { navLinks, esActual } from '../lib/nav';
---
<BaseLayout
  title="Análisis gratis de tu CV · Solca"
  description="Recibe feedback estructurado contra 20 criterios de selección en industria farmacéutica. Coherencia, métricas, palabras clave, compatibilidad ATS, posicionamiento. Gratis, sin pago, sin compromiso."
>

<!-- ==================== NAV ==================== -->
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <span class="dot"></span>
      <span>Solca</span>
    </a>
    <div class="nav-links">
      {navLinks({ inicio: false }).map((l) => <a href={l.href} aria-current={esActual(l.href, Astro.url.pathname) ? 'page' : undefined}>{l.texto}</a>)}
    </div>
  </div>
</nav>

<!-- ==================== HERO ==================== -->
<section class="cv-hero">
  <div class="diagonals"></div>
  <div class="container cv-hero-inner">
    <div class="eyebrow">
      <span class="dot"></span>
      <span>Recurso gratuito</span>
    </div>
    <h1 class="cv-hero-title">Análisis profesional de <em>tu CV</em></h1>
    <p class="cv-hero-lead">
      Pega tu CV y recibe feedback estructurado en 20 criterios de redacción y estructura para procesos de selección en la industria farmacéutica: coherencia, métricas, palabras clave, compatibilidad ATS, posicionamiento profesional. Sin pago, sin compromiso.
    </p>
    <div class="cv-hero-meta">
      <span class="meta-item"><span class="meta-dot"></span>Análisis cualitativo</span>
      <span class="meta-item"><span class="meta-dot"></span>20 categorías evaluadas</span>
      <span class="meta-item"><span class="meta-dot"></span>Recomendaciones accionables</span>
    </div>
  </div>
</section>

<!-- ==================== FORM ==================== -->
<section class="cv-form-section" id="form">
  <div class="container">
    <form id="cv-form" class="cv-form" novalidate>
      <div class="cv-form-grid">
        <div class="field full">
          <label for="cv-upload">Sube tu CV como PDF <span class="optional-label">(o pega el texto abajo)</span></label>
          <div class="upload-wrap">
            <input type="file" id="cv-upload" accept="application/pdf,.pdf" />
            <span id="upload-status" class="upload-status"></span>
          </div>
          <p class="field-help" style="margin-bottom: 14px;">
            El PDF se procesa localmente en tu navegador. No se sube a nuestro servidor.
          </p>

          <!-- Aviso · PDF no legible · también pista sobre ATS · oculto por default -->
          <aside class="pdf-warning" id="pdf-warning" hidden>
            <div class="pdf-warning-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div class="pdf-warning-content">
              <h4>Tu PDF no se pudo leer</h4>
              <p>
                Esto suele significar que el PDF tiene el texto como imagen (escaneado), usa una fuente que los parsers no entienden, o tiene un layout complejo (columnas, gráficos, íconos).
              </p>
              <p class="pdf-warning-callout">
                <strong>Importante:</strong> muchas plataformas de postulación leen el CV de forma automática. Si tu PDF no se pudo leer aquí, <strong>es posible que esas plataformas tampoco lo lean bien</strong>.
              </p>
              <p class="pdf-warning-actions-label">Antes de seguir, vale la pena leer:</p>
              <ul class="pdf-warning-actions">
                <li>
                  <a href={atsBlogURL} target="_blank" rel="noopener">
                    → Por qué tu CV no pasa filtros ATS (artículo)
                  </a>
                </li>
                <li>
                  <a href={newsletterURL} target="_blank" rel="noopener">
                    → Suscribirte al newsletter Solca Insight en LinkedIn
                  </a>
                </li>
              </ul>
              <p class="pdf-warning-fallback">
                Mientras decides cómo arreglar tu CV, puedes pegar el texto abajo y recibir el análisis de la versión actual.
              </p>
            </div>
          </aside>

          <!-- 6 nov 2026: el recuadro siempre está visible. Tras leer un PDF muestra el texto extraído para revisarlo y editarlo. -->
          <div class="textarea-wrapper" id="textarea-wrapper">
            <label for="cv" id="cv-label">Si prefieres, puedes pegar el texto de tu CV en este recuadro en vez de subirlo</label>
            <p class="field-help extract-help" id="extract-help" hidden>
              Este es el texto que leímos de tu PDF. Revísalo: si algo salió en desorden o sobra, corrígelo aquí antes de enviar.
            </p>
            <textarea
              id="cv"
              name="cv"
              rows="14"
              placeholder="Abre tu CV en Word o Pages, selecciona todo, copia y pega aquí."
              required
              minlength="200"
              aria-describedby="cv-help cv-error"
            ></textarea>
            <p id="cv-help" class="field-help">
              Mínimo 200 caracteres. Máximo 15,000. <span id="cv-count" class="cv-count">0 caracteres</span>
            </p>
            <p id="cv-error" class="field-error" role="alert" hidden></p>
          </div>
        </div>

        <div class="field">
          <label for="email">Tu email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="tu@email.com"
            required
            autocomplete="email"
          />
        </div>

        <div class="field">
          <label for="country">País (opcional)</label>
          <select id="country" name="country">
            <option value="">Selecciona</option>
            <option value="México">México</option>
            <option value="Brasil">Brasil</option>
            <option value="Argentina">Argentina</option>
            <option value="Colombia">Colombia</option>
            <option value="Chile">Chile</option>
            <option value="España">España</option>
            <option value="Perú">Perú</option>
            <option value="Ecuador">Ecuador</option>
            <option value="Otro LATAM">Otro LATAM</option>
            <option value="Otro">Otro</option>
          </select>
        </div>

        <div class="field full">
          <label for="rol_objetivo">¿A qué rol apuntas? <span class="optional-label">(opcional)</span></label>
          <select id="rol_objetivo" name="rol_objetivo">
            <option value="">Selecciona</option>
            {roleOptions.map(([value, label]) => <option value={value}>{label}</option>)}
            <option value={ROL_NO_SEGURO}>{ROL_NO_SEGURO_LABEL}</option>
          </select>
          <p class="field-help">Si lo eliges, el análisis revisa tu CV contra ese tipo de rol.</p>
        </div>

        <div class="field full consent-field">
          <label class="consent-label">
            <input type="checkbox" id="consent" name="consent" required />
            <span set:html={consentPrivacidadHtml} />
          </label>
          <label class="consent-label">
            <input type="checkbox" id="marketing" name="marketing" />
            <span>{consentCv.marketing}</span>
          </label>
          <p class="consent-note">{consentCv.nota}</p>
          <p class="consent-common" id="consent-common" data-consent-err={consentErrMsg}>{CONSENT_COMMON}</p>
        </div>

        <div class="field full">
          <button type="submit" id="submit-btn" class="btn btn-orange btn-large btn-block">
            Recibir mi análisis
          </button>
        </div>
      </div>
    </form>
    <ToolShare
      herramienta="revisar-cv"
      ruta="/revisar-cv"
      texto="Herramienta que revisa tu CV contra 20 criterios para roles en la industria farmacéutica."
    />
  </div>
</section>

<!-- ==================== LOADING ==================== -->
<section class="cv-loading" id="loading" hidden>
  <div class="container">
    <div class="loading-card">
      <div class="spinner" aria-hidden="true"></div>
      <h2>Analizando tu CV…</h2>
      <p id="loading-status">Leyendo estructura y experiencias.</p>
      <p class="loading-fineprint">Esto toma 15-30 segundos. No cierres ni recargues esta pestaña.</p>
    </div>
  </div>
</section>

<!-- ==================== RESULT ==================== -->
<section class="cv-result" id="result" hidden>
  <div class="container">
    <!-- Brand header (aparece arriba del resultado y se imprime en PDF) -->
    <div class="result-brand-header">
      <a href="/" class="result-brand-mark">
        <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="32" height="32" rx="6" fill="#0F2748"/>
          <circle cx="16" cy="16" r="5" fill="#E8743A"/>
          <circle cx="16" cy="16" r="9" fill="none" stroke="#E8743A" stroke-width="1.4" opacity="0.45"/>
        </svg>
        <span class="result-brand-text">
          <span class="result-brand-name">Solca</span>
          <span class="result-brand-tag">Ciencia y Consultoría</span>
        </span>
      </a>
      <div class="result-brand-meta">
        <a href="mailto:hello@solcaciencia.com">hello@solcaciencia.com</a>
      </div>
    </div>

    <header class="result-header">
      <div class="eyebrow">
        <span class="dot"></span>
        <span>Análisis de CV</span>
      </div>
      <h2 id="result-title">Análisis de CV</h2>
      <p class="result-meta" id="result-meta"></p>
      <div class="result-actions result-actions-top">
        <button type="button" id="download-btn" class="btn btn-orange">
          <span class="download-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </span>
          Descargar PDF
        </button>
      </div>
    </header>

    <!-- 6 nov 2026 (rúbrica v2): orden de la auditoría §2.3. Resumen y prioridades nunca se pliegan. -->
    <article class="result-card result-summary" aria-labelledby="summary-h">
      <h3 id="summary-h">Resumen</h3>
      <p class="summary-line" id="summary-line"></p>
      <p class="state-counts" id="state-counts"></p>
      <div class="state-bar" id="state-bar" aria-hidden="true"></div>
      <p class="summary-perfil" id="summary-perfil"></p>
      <p class="summary-disclaimer">Es una lectura de tu CV contra criterios de redacción y estructura; no predice si te van a llamar.</p>
      <p class="summary-partial" id="summary-partial" hidden>Parte del análisis no se pudo completar; te mostramos lo que sí quedó.</p>
    </article>

    <article class="result-card" id="priorities-card" aria-labelledby="prio-h">
      <h3 id="prio-h">Qué cambiar primero</h3>
      <ol class="priorities" id="priorities-list"></ol>
    </article>

    <article class="result-card" id="rewrites-card" aria-labelledby="rew-h">
      <h3 id="rew-h">Así se vería</h3>
      <p class="card-help">Tomamos frases de tu CV y las reescribimos. Lo que va entre corchetes es un dato que solo tú tienes: complétalo o quítalo.</p>
      <div id="rewrites-list"></div>
    </article>

    <article class="result-card" aria-labelledby="det-h">
      <h3 id="det-h">Detalle por área</h3>
      <div id="groups-list"></div>
    </article>

    <article class="result-card result-feedback">
      <h3>Retroalimentación general</h3>
      <p id="result-retroalimentacion"></p>
    </article>

    <article class="result-cta" id="next-step" data-curso={cursoURL}>
      <h3>Siguiente paso sugerido</h3>
      <div id="next-step-body"></div>
      <p class="result-sign">
        — Oscar Solís · <em>Director general, Solca Ciencia y Consultoría</em>
      </p>
    </article>

    <aside class="result-card result-bridge" id="waitlist-card">
      <p class="bridge-line">Este análisis es general; no compara tu CV con una vacante.</p>
      <button type="button" id="waitlist-btn" class="btn btn-secondary btn-navy">{WAITLIST_BOTON}</button>
      <p class="field-help" id="waitlist-note">{WAITLIST_NOTA}</p>
      <p class="bridge-done" id="waitlist-done" role="status" hidden></p>
      <!-- 10 nov 2026: puente a la comparación con una vacante. Solo tráfico interno (?interno=1) hasta diciembre. -->
      <a class="btn btn-secondary btn-navy" id="cotejo-link" data-href="/comparar-cv/?ref=cv" rel="nofollow" hidden>¿Tienes una vacante en mente? Compárala gratis</a>
    </aside>

    <div class="result-card result-useful" id="useful-card">
      <span class="useful-q" id="useful-q">¿Te sirvió este análisis?</span>
      <button type="button" class="btn-chip" data-useful="si">Sí</button>
      <button type="button" class="btn-chip" data-useful="no">No</button>
      <span class="useful-thanks" id="useful-thanks" role="status" hidden>Gracias. Lo usamos para mejorar el análisis.</span>
    </div>

    <!-- ==================== POST-RESULT SURVEY (anónima, opcional) ==================== -->
    <MarketSurvey origen="cv" />

    <div class="result-actions">
      <button type="button" id="retry-btn" class="btn btn-secondary" style="color: var(--navy); border-color: var(--navy);">
        Revisar otro CV
      </button>
    </div>

    <!-- 6 nov 2026: se quitó la barra de compartir después del resultado; compartir la herramienta vive en ToolShare, debajo del formulario. -->
  </div>
</section>

<!-- ==================== ERROR ==================== -->
<section class="cv-error" id="error" hidden>
  <div class="container">
    <div class="error-card">
      <h2 id="error-title">Algo salió mal</h2>
      <p id="error-message">Intenta de nuevo en un momento.</p>
      <button type="button" id="error-retry-btn" class="btn btn-primary">Intentar otra vez</button>
    </div>
  </div>
</section>

<!-- ==================== FOOTER ==================== -->
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="eyebrow eyebrow-light">
        <span class="dot"></span>
        <span>Solca · Ciencia y Consultoría</span>
      </div>
      <p>Acompañamiento profesional en la transición de academia a industria farmacéutica para profesionales en ciencias en LATAM y España.</p>
    </div>
    <div class="footer-links">
      <h4>Recursos</h4>
      <a href="/revisar-cv">Análisis de CV</a>
      <a href="/#libros">Libros</a>
      <a href="/#curso">Curso CV+LinkedIn</a>
    </div>
    <div class="footer-links">
      <h4>Sitio</h4>
      <a href="/">Inicio</a>
      <a href="/#sobre">Sobre Solca</a>
      <a href="/contacto">Contacto</a>
      <a href="/privacidad">Privacidad</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Oscar Omar Solís Castro · Solca · Ciencia y Consultoría. · <a href="/privacidad" style="color: inherit; text-decoration: underline;">Aviso de privacidad</a></p>
  </div>
</footer>

<style>
  /* Aseguramos que el atributo HTML `hidden` siempre gana sobre `display: flex/grid`.
     Sin esta regla, .pdf-warning[hidden] se ve igualmente porque su display: flex lo override. */
  [hidden] { display: none !important; }

  /* ============ CV Hero ============ */
  .cv-hero {
    position: relative;
    background:
      radial-gradient(ellipse at 80% 15%, rgba(232,116,58,0.13) 0%, transparent 55%),
      radial-gradient(ellipse at 15% 90%, rgba(42,107,172,0.18) 0%, transparent 55%),
      linear-gradient(135deg, var(--navy) 0%, var(--navy-deep) 100%);
    color: var(--off-white);
    padding: 80px 0 70px;
    overflow: hidden;
  }
  .cv-hero-inner { position: relative; z-index: 2; max-width: 820px; }
  .cv-hero-title {
    font-family: 'Inter', sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 5vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-bottom: 18px;
    color: var(--off-white);
  }
  .cv-hero-title em { font-style: normal; color: var(--orange); }
  .cv-hero-lead {
    font-size: 18px;
    line-height: 1.55;
    color: var(--off-white-mute);
    margin-bottom: 24px;
    max-width: 720px;
  }
  .cv-hero-meta {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--off-white-mute);
  }
  .meta-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--orange);
  }

  /* ============ Form ============ */
  .cv-form-section { background: var(--bg); padding: 70px 0; }
  .cv-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    max-width: 820px;
    margin: 0 auto;
    background: var(--off-white);
    padding: 36px;
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field.full { grid-column: 1 / -1; }
  .field label {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: var(--text);
  }
  .field input, .field select, .field textarea {
    padding: 12px 14px;
    border: 1.5px solid var(--rule);
    border-radius: 8px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: var(--text);
    background: white;
    transition: border-color 0.2s;
  }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: 0;
    border-color: var(--orange);
  }
  .field textarea {
    resize: vertical;
    min-height: 220px;
    line-height: 1.5;
    font-family: 'Inter', sans-serif;
  }
  .field-help {
    font-size: 12px;
    color: var(--text-mute);
    margin-top: 4px;
  }
  .optional-label {
    font-weight: 400;
    color: var(--text-mute);
    font-size: 13px;
  }
  .upload-wrap {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 14px;
    background: var(--bg);
    border: 1.5px dashed var(--rule);
    border-radius: 8px;
    margin-bottom: 4px;
  }
  .upload-wrap input[type="file"] {
    flex: 1;
    min-width: 200px;
    padding: 0;
    border: 0;
    background: transparent;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: var(--text);
  }
  .upload-wrap input[type="file"]::file-selector-button {
    padding: 8px 14px;
    margin-right: 12px;
    border: 0;
    border-radius: 6px;
    background: var(--navy);
    color: var(--off-white);
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
  }
  .upload-wrap input[type="file"]::file-selector-button:hover {
    background: var(--navy-deep);
  }
  .upload-status {
    font-size: 13px;
    color: var(--text-mute);
    font-family: 'Inter', sans-serif;
  }
  .upload-status.success { color: var(--orange); font-weight: 600; }
  .upload-status.error { color: #C04040; font-weight: 600; }

  .textarea-collapsed {
    margin-top: 8px;
    padding: 14px 18px;
    background: rgba(232,116,58,0.08);
    border: 1px solid rgba(232,116,58,0.20);
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .textarea-toggle-btn {
    background: transparent;
    border: 1.5px solid var(--orange);
    color: var(--orange);
    padding: 8px 16px;
    border-radius: 6px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .textarea-toggle-btn:hover {
    background: var(--orange);
    color: var(--off-white);
  }

  /* PDF parsing failure callout · ATS pista */
  .pdf-warning {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    background: rgba(232,116,58,0.06);
    border: 1.5px solid rgba(232,116,58,0.30);
    border-left: 4px solid var(--orange);
    border-radius: 8px;
    padding: 18px 22px;
    margin: 6px 0 14px;
  }
  .pdf-warning-icon {
    flex-shrink: 0;
    color: var(--orange);
    margin-top: 2px;
  }
  .pdf-warning-content { flex: 1; min-width: 0; }
  .pdf-warning h4 {
    font-family: 'Inter', sans-serif;
    font-weight: 800;
    font-size: 17px;
    color: var(--navy);
    margin: 0 0 8px;
    letter-spacing: -0.005em;
  }
  .pdf-warning p {
    font-size: 14px;
    line-height: 1.55;
    color: var(--text);
    margin: 0 0 10px;
  }
  .pdf-warning-callout {
    background: rgba(15,39,72,0.04);
    border-radius: 6px;
    padding: 10px 14px;
    margin: 12px 0 14px !important;
    font-size: 14px !important;
    line-height: 1.55;
    color: var(--text) !important;
  }
  .pdf-warning-callout strong { color: var(--navy); font-weight: 700; }
  .pdf-warning-actions-label {
    font-size: 13px !important;
    color: var(--text-mute) !important;
    font-weight: 600;
