<script>
  // 6 nov 2026 (rúbrica v2): grupos, conteos y siguiente paso salen del mismo módulo que usa el endpoint.
  import {
    countByEstado,
    cursoLead,
    groupObservaciones,
    pickNextStep,
    topGrupo,
    type CvReviewResult,
    type Estado,
    type GrupoId,
    type NextStep,
    type Observacion,
  } from '../lib/cv-review-rubric';

  // Referrer externo del aterrizaje (20 oct 2026). Se guarda en sessionStorage al cargar
  // para que "Revisar otro CV" o una recarga no lo pierdan; se ignora el propio dominio.
  function landingReferrer(): string | undefined {
    try {
      const stored = sessionStorage.getItem('cv_ref');
      if (stored) return stored;
    } catch { /* storage bloqueado */ }
    const ref = document.referrer;
    if (!ref) return undefined;
    try {
      if (new URL(ref).hostname === window.location.hostname) return undefined;
    } catch {
      return undefined;
    }
    return ref.slice(0, 300);
  }
  try {
    const ref = landingReferrer();
    if (ref) sessionStorage.setItem('cv_ref', ref);
  } catch { /* storage bloqueado */ }

  const MIN_CV = 200;
  const MAX_CV = 15000;

  const form = document.getElementById('cv-form') as HTMLFormElement | null;
  const loading = document.getElementById('loading') as HTMLElement | null;
  const loadingStatus = document.getElementById('loading-status') as HTMLElement | null;
  const result = document.getElementById('result') as HTMLElement | null;
  const errorSection = document.getElementById('error') as HTMLElement | null;
  const errorMessage = document.getElementById('error-message') as HTMLElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement | null;
  const retryBtn = document.getElementById('retry-btn') as HTMLButtonElement | null;
  const errorRetryBtn = document.getElementById('error-retry-btn') as HTMLButtonElement | null;
  const cvTextarea = document.getElementById('cv') as HTMLTextAreaElement | null;
  const cvUpload = document.getElementById('cv-upload') as HTMLInputElement | null;
  const uploadStatus = document.getElementById('upload-status') as HTMLElement | null;
  const pdfWarning = document.getElementById('pdf-warning') as HTMLElement | null;
  const extractHelp = document.getElementById('extract-help') as HTMLElement | null;
  const cvCount = document.getElementById('cv-count') as HTMLElement | null;
  const cvError = document.getElementById('cv-error') as HTMLElement | null;

  function hide(el: HTMLElement | null) { if (el) el.hidden = true; }
  function show(el: HTMLElement | null) { if (el) el.hidden = false; }
  // 6 nov 2026: pasos del revisor de CV como evento cv_step (best-effort, no bloquea el flujo).
  function cvStep(product: string) {
    try {
      const w = window as unknown as { __utm?: Record<string, string>; __attr?: () => Record<string, unknown> };
      const utm = w.__utm || {};
      const body = JSON.stringify({ event: 'cv_step', product, utm_source: utm.utm_source, utm_medium: utm.utm_medium, utm_campaign: utm.utm_campaign, utm_content: utm.utm_content, ...(w.__attr ? w.__attr() : {}) });
      if (navigator.sendBeacon) navigator.sendBeacon('/api/simulator-events', new Blob([body], { type: 'application/json' }));
      else fetch('/api/simulator-events', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body, keepalive: true }).catch(() => {});
    } catch { /* medición best-effort */ }
  }

  // Origen del texto que se manda al análisis (6 nov 2026). Si la persona edita el texto extraído, sigue siendo 'pdf'.
  let extract: { origen: 'pdf' | 'pegado'; paginas: number | null } = { origen: 'pegado', paginas: null };

  function updateCount() {
    if (!cvTextarea || !cvCount) return;
    const n = cvTextarea.value.trim().length;
    cvCount.textContent = `${n.toLocaleString('es-MX')} caracteres`;
    cvCount.classList.toggle('over', n > MAX_CV);
    if (n <= MAX_CV && cvError && !cvError.hidden && n >= MIN_CV) hide(cvError);
  }
  function showCvError(msg: string) {
    if (cvError) {
      cvError.textContent = msg;
      show(cvError);
    }
    cvTextarea?.focus();
    cvTextarea?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  cvTextarea?.addEventListener('input', updateCount);

  // ---- PDF upload: lazy-load pdf.js from CDN, extract text, fill textarea ----
  let pdfjsPromise: Promise<any> | null = null;
  async function loadPdfJs() {
    if (!pdfjsPromise) {
      pdfjsPromise = (async () => {
        const lib = await import(
          /* @vite-ignore */ 'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.min.mjs'
        );
        lib.GlobalWorkerOptions.workerSrc =
          'https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.worker.min.mjs';
        return lib;
      })();
    }
    return pdfjsPromise;
  }

  function setUploadStatus(text: string, kind: 'idle' | 'success' | 'error' = 'idle') {
    if (!uploadStatus) return;
    uploadStatus.textContent = text;
    uploadStatus.classList.remove('success', 'error');
    if (kind !== 'idle') uploadStatus.classList.add(kind);
  }

  /**
   * Texto de una página conservando los saltos de línea (6 nov 2026). pdf.js 4.x marca el fin de línea con
   * `hasEOL`; además se corta la línea cuando cambia la coordenada vertical (transform[5]) por si falta la marca.
   */
  function pageTextWithBreaks(items: Array<{ str?: string; hasEOL?: boolean; transform?: number[] }>): string {
    let out = '';
    let lastY: number | null = null;
    for (const it of items) {
      const str = it.str ?? '';
      const y = Array.isArray(it.transform) ? it.transform[5] : null;
      if (str && lastY !== null && y !== null && Math.abs(y - lastY) > 2 && !out.endsWith('\n')) out += '\n';
      out += str;
      if (it.hasEOL) out += '\n';
      if (str && y !== null) lastY = y;
    }
    return out
      .split('\n')
      .map((l) => l.replace(/[ \t ]+/g, ' ').trim())
      .join('\n')
      .replace(/\n{3,}/g, '\n\n')
      .trim();
  }

  function setExtractMode(fromPdf: boolean) {
    if (extractHelp) extractHelp.hidden = !fromPdf;
  }

  cvUpload?.addEventListener('change', async (e) => {
    const target = e.target as HTMLInputElement;
    const file = target.files?.[0];

    // Usuario quitó el archivo → volver a "pegar texto".
    if (!file) {
      setUploadStatus('', 'idle');
      hide(pdfWarning);
      setExtractMode(false);
      extract = { origen: 'pegado', paginas: null };
      if (cvTextarea) cvTextarea.value = '';
      updateCount();
      return;
    }

    hide(pdfWarning);

    if (file.type !== 'application/pdf' && !file.name.toLowerCase().endsWith('.pdf')) {
      setUploadStatus('Solo PDFs. Para otros formatos, pega el texto.', 'error');
      target.value = '';
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      setUploadStatus('PDF excede 10 MB. Reduce el archivo o pega el texto.', 'error');
      target.value = '';
      return;
    }

    setUploadStatus('Procesando PDF...', 'idle');

    try {
      const pdfjsLib = await loadPdfJs();
      const arrayBuffer = await file.arrayBuffer();
      const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
      const pages: string[] = [];
      for (let i = 1; i <= pdf.numPages; i++) {
        const page = await pdf.getPage(i);
        const content = await page.getTextContent();
        pages.push(pageTextWithBreaks(content.items));
      }
      const fullText = pages.join('\n\n').trim();
      if (cvTextarea) cvTextarea.value = fullText;
      updateCount();
      if (fullText.length < MIN_CV) {
        setUploadStatus(`Solo se extrajeron ${fullText.length} caracteres.`, 'error');
        cvStep('pdf_fail');
        show(pdfWarning);
        setExtractMode(false);
        extract = { origen: 'pegado', paginas: null };
      } else {
        setUploadStatus(
          `✓ PDF cargado · ${pdf.numPages} ${pdf.numPages === 1 ? 'página' : 'páginas'} · ${fullText.length.toLocaleString('es-MX')} caracteres extraídos`,
          'success',
        );
        cvStep('pdf_ok');
        hide(pdfWarning);
        setExtractMode(true);
        extract = { origen: 'pdf', paginas: pdf.numPages };
        if (fullText.length > MAX_CV) {
          showCvError(`Leímos ${fullText.length.toLocaleString('es-MX')} caracteres y el máximo es 15,000. Recorta en el recuadro lo menos relevante (por ejemplo, la lista completa de congresos o cursos).`);
        }
      }
    } catch (err) {
      console.error('PDF parse error:', err);
      setUploadStatus('No pudimos leer el PDF.', 'error');
      cvStep('pdf_fail');
      show(pdfWarning);
      setExtractMode(false);
      extract = { origen: 'pegado', paginas: null };
    }
  });

  function setStatusCycling() {
    if (!loadingStatus) return null;
    const messages = [
      'Leyendo estructura y experiencias.',
      'Revisando el resumen y el rol al que apuntas.',
      'Buscando logros, verbos y resultados.',
      'Revisando palabras clave del rol.',
      'Ordenando lo que conviene cambiar primero.',
      'Preparando ejemplos con frases de tu CV.',
    ];
    let i = 0;
    const interval = window.setInterval(() => {
      i = (i + 1) % messages.length;
      if (loadingStatus) loadingStatus.textContent = messages[i] ?? '';
    }, 3500);
    return interval;
  }

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  type Result = CvReviewResult & { parcial?: boolean };

  // Forma + palabra + color para cada estado (WCAG 1.4.1: el color nunca va solo).
  const ESTADO_UI: Record<Estado, { sym: string; label: string }> = {
    prioritario: { sym: '▲', label: 'Prioritario' },
    mejorable: { sym: '■', label: 'Mejorable' },
    solido: { sym: '●', label: 'Sólido' },
    no_evaluable: { sym: '○', label: 'No evaluable' },
  };
  const ESTADO_ORDEN: Estado[] = ['prioritario', 'mejorable', 'solido', 'no_evaluable'];
  function stateTag(e: Estado, withLabel = true): string {
    const u = ESTADO_UI[e];
    return `<i class="st st-${e}" aria-hidden="true">${u.sym}</i>${withLabel ? ` <span class="obs-state st-${e}">${u.label}</span>` : ''}`;
  }
  function huecos(html: string): string {
    return html.replace(/\[([^\]]{1,60})\]/g, '<span class="rw-hueco">[$1]</span>');
  }

  // Siguiente paso: textos y destinos. En pantalla, simulador y quiz llevan data-next-step (BaseLayout registra
  // next_step_clicked); el curso no, para que BaseLayout le ponga src y registre book_clicked.
  const cursoUrl = (document.getElementById('next-step') as HTMLElement | null)?.dataset.curso || 'https://go.hotmart.com/B104495115T';
  const PDF_UTM = 'utm_source=pdf&utm_medium=cv-report&utm_campaign=revisar-cv';
  function nextStepCopy(step: NextStep, data: Result) {
    if (step === 'quiz') {
      return {
        title: 'Define a qué rol apuntas',
        body: data.perfil.rol_objetivo
          ? 'Lo más urgente en tu CV es el posicionamiento: que se entienda pronto a qué rol apuntas y por qué encajas. Si todavía dudas entre roles, el quiz te ayuda a elegir entre 5 roles de la industria.'
          : 'En esta lectura tu CV todavía no deja claro a qué puesto apunta, y varios criterios de este análisis dependen de eso. El quiz de rol te ayuda a elegir entre 5 roles de la industria.',
        cta: 'Hacer el quiz de rol',
        href: '/quiz-rol?ref=cv',
        hrefPdf: `https://solcaciencia.com/quiz-rol?ref=cv&${PDF_UTM}`,
        track: 'cv-quiz',
      };
    }
    if (step === 'simulador') {
      return {
        title: 'Ensaya la primera llamada',
        body: 'En esta lectura tu CV no tiene puntos prioritarios. El siguiente paso es la entrevista: el simulador te ayuda a ensayar la llamada inicial con un reclutador. La primera sesión no tiene costo.',
        cta: 'Ensayar mi primera llamada',
        href: '/simulador-entrevistas/?ref=cv',
        hrefPdf: `https://solcaciencia.com/simulador-entrevistas/?ref=cv&${PDF_UTM}`,
        track: 'cv-simulador',
      };
    }
    return {
      title: 'Trabaja la redacción de tu CV',
      body: `${cursoLead(data, lastRol)} El curso explica cómo redactar un CV, optimizar LinkedIn y aplicar de forma estratégica. Los ejemplos son de ciencias biológicas y de la salud.`,
      cta: 'Ver el curso en Hotmart',
      href: cursoUrl,
      hrefPdf: `${cursoUrl}${cursoUrl.includes('?') ? '&' : '?'}src=cv-reporte-pdf`,
      track: '',
    };
  }

  // Guardamos el último análisis para el PDF, y el correo para el "Avísame".
  let lastResult: Result | null = null;
  let lastEmail = '';
  let lastRol = '';
  const openedGroups = new Set<string>();

  function fechaLarga(): string {
    return new Date().toLocaleDateString('es-MX', { day: 'numeric', month: 'long', year: 'numeric' });
  }

  function renderResult(data: Result) {
    lastResult = data;
    openedGroups.clear();
    cvStep('result_viewed');
    const set = (id: string, html: string) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = html;
    };
    const titleEl = document.getElementById('result-title');
    if (titleEl) titleEl.textContent = `Análisis de CV · ${data.candidateName}`;
    set('result-meta', `${escapeHtml(fechaLarga())} · Rúbrica ${escapeHtml(data.rubric_version)}`);

    // Resumen
    const summaryLine = document.getElementById('summary-line');
    if (summaryLine) {
      summaryLine.textContent = data.resumen.una_linea ?? '';
      summaryLine.hidden = !data.resumen.una_linea;
    }
    const counts = countByEstado(data.observaciones);
    set(
      'state-counts',
      ESTADO_ORDEN.map((e) => `<span class="state-count">${stateTag(e, false)} <strong>${counts[e]}</strong> ${ESTADO_UI[e].label}</span>`).join(''),
    );
    set(
      'state-bar',
      ESTADO_ORDEN.flatMap((e) => Array.from({ length: counts[e] }, () => `<span class="b-${e}"></span>`)).join(''),
    );
    set(
      'summary-perfil',
      `<strong>Perfil leído:</strong> ${escapeHtml(data.perfil.nivel)} · <strong>Apunta a:</strong> ${escapeHtml(data.perfil.rol_objetivo ?? 'no se distingue')}`,
    );
    const partial = document.getElementById('summary-partial');
    if (partial) partial.hidden = !data.parcial;

    // Qué cambiar primero
    set(
      'priorities-list',
      data.prioridades
        .map((p) => {
          const o = data.observaciones.find((x) => x.id === p.id_observacion);
          return `<li>
  <p class="prio-accion">${o ? stateTag(o.estado, false) + ' ' : ''}${escapeHtml(p.accion)}</p>
  ${p.por_que ? `<p class="prio-meta"><b>Por qué:</b> ${escapeHtml(p.por_que)}</p>` : ''}
  ${p.esfuerzo ? `<p class="prio-meta"><b>Esfuerzo:</b> ${escapeHtml(p.esfuerzo)}</p>` : ''}
  ${o ? `<p class="prio-meta"><b>Área:</b> ${escapeHtml(o.categoria)}</p>` : ''}
</li>`;
        })
        .join(''),
    );
    const prioCard = document.getElementById('priorities-card');
    if (prioCard) prioCard.hidden = data.prioridades.length === 0;

    // Así se vería
    set(
      'rewrites-list',
      data.reescrituras
        .map(
          (r) => `<div class="rewrite">
  <p><span class="rw-label">Antes</span> “${escapeHtml(r.antes)}”</p>
  <p class="rw-despues"><span class="rw-label">Después</span> “${huecos(escapeHtml(r.despues))}”</p>
  ${r.principio ? `<p class="rw-principio">Por qué: ${escapeHtml(r.principio)}</p>` : ''}
</div>`,
        )
        .join(''),
    );
    const rwCard = document.getElementById('rewrites-card');
    if (rwCard) rwCard.hidden = data.reescrituras.length === 0;

    // Detalle por área (6 grupos plegables)
    const groups = groupObservaciones(data.observaciones);
    const mobile = window.matchMedia('(max-width: 720px)').matches;
    let top: GrupoId | null = topGrupo(data.observaciones);
    if (!top) {
      // Sin ▲: abre el grupo con más ■.
      let max = 0;
      for (const g of groups) if (g.counts.mejorable > max) { max = g.counts.mejorable; top = g.id; }
    }
    set(
      'groups-list',
      groups
        .map((g) => {
          const open = mobile ? g.id === top : g.counts.prioritario > 0 || g.id === top;
          const countsHtml = ESTADO_ORDEN.filter((e) => g.counts[e] > 0)
            .map((e) => `<span title="${ESTADO_UI[e].label}">${stateTag(e, false)}<span class="sr-only"> ${ESTADO_UI[e].label}</span> ${g.counts[e]}</span>`)
            .join('');
          const note =
            g.id === 'formato_ats' && lastResult
              ? `<p class="grp-note">${extractNote()}</p>`
              : '';
          const items = g.items.length
            ? g.items.map((o) => obsHtml(o)).join('')
            : '<p class="grp-note">Sin datos en esta área.</p>';
          return `<details class="grp" data-grupo="${g.id}"${open ? ' open' : ''}>
  <summary><span class="grp-name">${escapeHtml(g.label)}</span><span class="grp-counts">${countsHtml}</span></summary>
  ${note}${items}
</details>`;
        })
        .join(''),
    );
    document.querySelectorAll<HTMLElement>('#groups-list details.grp > summary').forEach((sum) => {
      sum.addEventListener('click', () => {
        const det = sum.parentElement as HTMLDetailsElement;
        const id = det.dataset.grupo || '';
        // Solo cuenta aperturas hechas por la persona, una vez por grupo y análisis.
        if (!det.open && !openedGroups.has(id)) {
          openedGroups.add(id);
          cvStep(`group_opened:${id}`);
        }
      });
    });

    const retroEl = document.getElementById('result-retroalimentacion');
    if (retroEl) retroEl.textContent = data.retroalimentacion;
    const retroCard = retroEl?.closest('article') as HTMLElement | null;
    if (retroCard) retroCard.hidden = !data.retroalimentacion;

    // Un solo siguiente paso, elegido en código por el hallazgo principal.
    const step = pickNextStep(data, lastRol);
    const ns = nextStepCopy(step, data);
    const external = ns.href.startsWith('http');
    set(
      'next-step-body',
      `<h4 class="ns-title">${escapeHtml(ns.title)}</h4>
<p class="ns-body">${escapeHtml(ns.body)}</p>
<a href="${escapeHtml(ns.href)}" class="btn btn-orange btn-large"${external ? ' target="_blank" rel="noopener"' : ''}${ns.track ? ` data-next-step="${ns.track}"` : ''}>${escapeHtml(ns.cta)}</a>`,
    );
    cvStep(`next_step_shown:${step}`);

    // Estados de los botones de un clic.
    const wlBtn = document.getElementById('waitlist-btn') as HTMLButtonElement | null;
    if (wlBtn) wlBtn.disabled = false;
    hide(document.getElementById('waitlist-done'));
    document.querySelectorAll<HTMLButtonElement>('[data-useful]').forEach((b) => {
      b.disabled = false;
      b.classList.remove('is-picked');
    });
    hide(document.getElementById('useful-thanks'));
  }

  function extractNote(): string {
    return extract.origen === 'pdf'
      ? `Texto leído de tu PDF: ${extract.paginas} ${extract.paginas === 1 ? 'página' : 'páginas'}.`
      : 'El texto se pegó, así que el diseño del documento no se pudo revisar.';
  }

  function obsHtml(o: Observacion): string {
    if (o.estado === 'solido') {
      return `<div class="obs"><div class="obs-head">${stateTag(o.estado)} <span class="obs-name">${escapeHtml(o.categoria)}</span></div><p>${escapeHtml(o.evaluacion)}</p></div>`;
    }
    return `<div class="obs">
  <div class="obs-head">${stateTag(o.estado)} <span class="obs-name">${escapeHtml(o.categoria)}</span></div>
  <p>${escapeHtml(o.evaluacion)}</p>
  ${o.evidencia ? `<p class="obs-evid">En tu CV: “${escapeHtml(o.evidencia)}”</p>` : ''}
  ${o.recomendacion ? `<p class="obs-rec">→ ${escapeHtml(o.recomendacion)}</p>` : ''}
</div>`;
  }

  // Al imprimir con Cmd+P se abren todos los grupos.
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll<HTMLDetailsElement>('#groups-list details.grp').forEach((d) => (d.open = true));
  });

  // ---- "Avísame cuando esté disponible" (CV adaptado a una vacante) ----
  const waitlistBtn = document.getElementById('waitlist-btn') as HTMLButtonElement | null;
  waitlistBtn?.addEventListener('click', async () => {
    if (!waitlistBtn || !lastEmail) return;
    cvStep('avisame_cv_medida');
    waitlistBtn.disabled = true;
    const done = document.getElementById('waitlist-done');
    try {
      const res = await fetch('/api/cv-waitlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: lastEmail, producto: 'cv-medida', origen: 'pantalla', rol_objetivo: lastRol || undefined }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (done) done.textContent = `Listo. Te escribiremos a ${lastEmail} cuando esté disponible.`;
      show(done);
    } catch {
      waitlistBtn.disabled = false;
      if (done) done.textContent = 'No pudimos guardar tu aviso. Intenta de nuevo en un momento.';
      show(done);
    }
  });

  document.getElementById('cotejo-link')?.addEventListener('click', () => cvStep('cotejo_puente'));

  // ---- "¿Te sirvió este análisis?" en un clic ----
  document.querySelectorAll<HTMLButtonElement>('[data-useful]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const v = btn.dataset.useful === 'si' ? 'si' : 'no';
      cvStep(`util_${v}`);
      document.querySelectorAll<HTMLButtonElement>('[data-useful]').forEach((b) => (b.disabled = true));
      btn.classList.add('is-picked');
      show(document.getElementById('useful-thanks'));
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    const fd = new FormData(form);
    const cvText = String(fd.get('cv') ?? '').trim();
    const payload = {
      cv: cvText,
      email: String(fd.get('email') ?? '').trim(),
      country: String(fd.get('country') ?? ''),
      // 6 nov 2026 (rúbrica v2): rol objetivo opcional y señales de la extracción (sin texto adicional).
      rol_objetivo: String(fd.get('rol_objetivo') ?? '') || undefined,
      origen: extract.origen,
      paginas: extract.origen === 'pdf' ? extract.paginas : undefined,
      caracteres: cvText.length,
      consent: fd.get('consent') === 'on',
      // 2 nov 2026: casilla comercial opcional; el análisis funciona igual sin ella.
      marketing: fd.get('marketing') === 'on',
      // UTM attribution (P1 sprint 2026-08-18): window.__utm lo llena BaseLayout.
      ...(window.__utm || {}),
      // 30 oct 2026 (P2): aid, primer/último toque y bandera interna.
      ...(window.__attr ? window.__attr() : {}),
      // Página de origen externa (20 oct 2026): para ubicar picos que llegan sin UTM.
      referrer: landingReferrer(),
    };

    // Validación en cliente: el largo se avisa junto al recuadro (antes con alert y sin dónde recortar).
    if (payload.cv.length < MIN_CV) {
      showCvError('El CV es muy corto. Pega el texto completo (mínimo 200 caracteres).');
      return;
    }
    if (payload.cv.length > MAX_CV) {
      showCvError(`Tu CV tiene ${payload.cv.length.toLocaleString('es-MX')} caracteres y el máximo es 15,000. Recorta en el recuadro lo menos relevante (por ejemplo, la lista completa de congresos o cursos).`);
      return;
    }
    hide(cvError);
    if (!payload.consent) {
      alert(document.getElementById('consent-common')?.dataset.consentErr || 'Debes aceptar el aviso de privacidad para continuar.');
      return;
    }

    // Switch to loading
    hide(form.parentElement?.parentElement ?? null);
    hide(errorSection);
    show(loading);
    submitBtn && (submitBtn.disabled = true);
    const intervalId = setStatusCycling();

    try {
      const res = await fetch('/api/cv-review', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (intervalId) window.clearInterval(intervalId);

      // 6 nov 2026 (bloque B): el análisis falló y quedó pendiente; llega por correo. No se ofrece reintentar
      // aquí para no duplicar el análisis.
      if (res.status === 202) {
        const pend = (await res.json().catch(() => ({}))) as { message?: string };
        hide(loading);
        const errTitle = document.getElementById('error-title');
        if (errTitle) errTitle.textContent = 'Tu análisis llegará por correo';
        if (errorMessage) errorMessage.textContent = pend.message || 'Hubo un problema al generar tu análisis; te lo enviaremos por correo en cuanto esté listo.';
        hide(errorRetryBtn);
        show(errorSection);
        cvStep('pendiente_mostrado');
        return;
      }

      if (!res.ok) {
        const errBody = await res.json().catch(() => ({ message: 'Error desconocido' }));
        throw new Error(errBody.message || `HTTP ${res.status}`);
      }

      const data = (await res.json()) as Result;
      lastEmail = payload.email.toLowerCase();
      lastRol = payload.rol_objetivo ?? '';
      // 10 nov 2026: CV, correo y rol pasan a /comparar-cv por sessionStorage (nunca en la URL). Solo interno por ahora.
      if ((window as unknown as { __interno?: boolean }).__interno) {
        try {
          sessionStorage.setItem('solca_cotejo', JSON.stringify({ cv: payload.cv, email: lastEmail, rol: lastRol }));
        } catch {
          /* sin sessionStorage: la página pide el CV */
        }
        const cl = document.getElementById('cotejo-link') as HTMLAnchorElement | null;
        if (cl) cl.href = cl.dataset.href ?? '';
        show(cl);
      }
      renderResult(data);
      hide(loading);
      show(result);
      window.scrollTo({ top: result?.offsetTop ?? 0, behavior: 'smooth' });
    } catch (err) {
      if (intervalId) window.clearInterval(intervalId);
      hide(loading);
      const msg = err instanceof Error ? err.message : 'Error desconocido.';
      const errTitle = document.getElementById('error-title');
      if (errTitle) errTitle.textContent = 'Algo salió mal';
      show(errorRetryBtn);
      if (errorMessage) errorMessage.textContent = msg;
      show(errorSection);
      submitBtn && (submitBtn.disabled = false);
    }
  });

  // ---- PDF generation con jsPDF directo (texto nativo, no imagen) ----
  let jsPdfPromise: Promise<any> | null = null;
  function loadJsPdf(): Promise<any> {
    if (!jsPdfPromise) {
      jsPdfPromise = new Promise((resolve, reject) => {
        const w = window as any;
        if (w.jspdf?.jsPDF) { resolve(w.jspdf.jsPDF); return; }
        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/jspdf@2.5.2/dist/jspdf.umd.min.js';
        script.async = true;
        script.onload = () => {
          if (w.jspdf?.jsPDF) resolve(w.jspdf.jsPDF);
          else reject(new Error('jsPDF no se cargó correctamente'));
        };
        script.onerror = () => reject(new Error('No pudimos cargar la librería de PDF'));
        document.head.appendChild(script);
      });
    }
    return jsPdfPromise;
  }

  // Sanitiza texto para evitar caracteres no soportados por Helvetica (default font de jsPDF).
  // jsPDF + Helvetica solo cubren WinAnsi. Caracteres Unicode fuera de ese set rompen el
  // cálculo de ancho de splitTextToSize y el render se va off-page o se ve con letter spacing raro.
  function sanitizeForPDF(text: string): string {
    if (!text) return '';
    return text
      .replace(/→/g, '>')
      .replace(/←/g, '<')
      .replace(/↑/g, '^')
      .replace(/↓/g, 'v')
      .replace(/—/g, ' - ')
      .replace(/–/g, '-')
      .replace(/[‘’‚‛]/g, "'")
      .replace(/[“”„‟]/g, '"')
      .replace(/…/g, '...')
      .replace(/•/g, '*')
      .replace(/[▲■●○▸]/g, '')
      .replace(/✓/g, 'OK')
      .replace(/✗/g, 'X')
      .replace(/[‐-―]/g, '-')
      .replace(/[  ]/g, ' ')
      .replace(/[​‌‍﻿]/g, '');
  }

  /**
   * PDF v2 (auditoría §2.5): mismo orden que la pantalla. Página 1 accionable (resumen, conteos, qué cambiar
   * primero y un antes/después). Estados dibujados con figuras de jsPDF (Helvetica WinAnsi no tiene ▲■●○).
   * Detalle en tabla; los sólidos van en una línea. Pie con fecha, rubric_version y la línea "no predice".
   */
  function generatePdf(JsPDF: any, raw: Result): any {
    const doc = new JsPDF({ unit: 'mm', format: 'a4', orientation: 'portrait' });
    const S = sanitizeForPDF;

    const PAGE_W = 210;
    const PAGE_H = 297;
    const M_X = 18;
    const M_TOP = 18;
    const M_BOTTOM = 24;
    const C_W = PAGE_W - 2 * M_X;

    type RGB = [number, number, number];
    const NAVY: RGB = [27, 58, 107];
    const NAVY_DEEP: RGB = [15, 39, 72];
    const ORANGE: RGB = [232, 116, 58];
    const OFFW: RGB = [247, 245, 238];
    const TEXT: RGB = [27, 37, 64];
    const TEXTMUTE: RGB = [90, 100, 128];
    const RULE: RGB = [220, 218, 210];
    const BAND: RGB = [240, 238, 230];
    const EST_COLOR: Record<Estado, RGB> = {
      prioritario: [178, 58, 42],
      mejorable: [217, 162, 27],
      solido: [46, 125, 91],
      no_evaluable: [107, 116, 137],
    };

    let y = M_TOP;
    const fecha = fechaLarga();

    function setColor(setter: 'fill' | 'stroke' | 'text', c: RGB) {
      if (setter === 'fill') doc.setFillColor(c[0], c[1], c[2]);
      else if (setter === 'stroke') doc.setDrawColor(c[0], c[1], c[2]);
      else doc.setTextColor(c[0], c[1], c[2]);
    }
    function font(style: 'normal' | 'bold' | 'italic', size: number, color: RGB) {
      doc.setFont('helvetica', style);
      doc.setFontSize(size);
      setColor('text', color);
    }
    function needBreak(space: number) {
      if (y + space > PAGE_H - M_BOTTOM) {
        doc.addPage();
        y = M_TOP;
      }
    }
    function lines(text: string, width: number): string[] {
      return doc.splitTextToSize(S(text), width);
    }
    /** Escribe un párrafo con salto de página por línea. */
    function para(text: string, x: number, width: number, lh: number) {
      for (const l of lines(text, width)) {
        needBreak(lh);
        doc.text(l, x, y);
        y += lh;
      }
    }
    function section(title: string) {
      needBreak(16);
      font('bold', 13, NAVY);
      doc.text(S(title), M_X, y);
      setColor('stroke', ORANGE);
      doc.setLineWidth(0.7);
      doc.line(M_X, y + 1.5, M_X + doc.getTextWidth(S(title)), y + 1.5);
      y += 8;
    }
    /** Figura del estado centrada en (cx, cy). */
    function shape(e: Estado, cx: number, cy: number, r = 1.5) {
      setColor('fill', EST_COLOR[e]);
      setColor('stroke', EST_COLOR[e]);
      doc.setLineWidth(0.35);
      if (e === 'prioritario') doc.triangle(cx - r, cy + r * 0.9, cx + r, cy + r * 0.9, cx, cy - r * 1.1, 'F');
      else if (e === 'mejorable') doc.rect(cx - r * 0.9, cy - r * 0.9, r * 1.8, r * 1.8, 'F');
      else if (e === 'solido') doc.circle(cx, cy, r, 'F');
      else doc.circle(cx, cy, r * 0.95, 'S');
    }
    const LABEL: Record<Estado, string> = { prioritario: 'Prioritario', mejorable: 'Mejorable', solido: 'Sólido', no_evaluable: 'No evaluable' };

    // ===== ENCABEZADO =====
    setColor('fill', NAVY_DEEP);
    doc.roundedRect(M_X, y, 10, 10, 1.8, 1.8, 'F');
    setColor('fill', ORANGE);
    doc.circle(M_X + 5, y + 5, 1.5, 'F');
    setColor('stroke', ORANGE);
    doc.setLineWidth(0.35);
    doc.circle(M_X + 5, y + 5, 3, 'S');
    font('bold', 14, NAVY);
    doc.text('Solca', M_X + 13.5, y + 4.5);
    font('normal', 7.5, ORANGE);
    doc.text('CIENCIA Y CONSULTORÍA', M_X + 13.5, y + 9);
    font('normal', 9, TEXTMUTE);
    doc.text('hello@solcaciencia.com', PAGE_W - M_X, y + 7, { align: 'right' });
    y += 13;
    setColor('stroke', RULE);
    doc.setLineWidth(0.4);
    doc.line(M_X, y, PAGE_W - M_X, y);
    y += 10;

    font('bold', 8, ORANGE);
    doc.text('ANÁLISIS DE CV', M_X, y);
    y += 7;
    font('bold', 19, NAVY);
    const tl = lines(`Análisis de CV · ${raw.candidateName}`, C_W);
    tl.forEach((l, i) => doc.text(l, M_X, y + i * 8));
    y += tl.length * 8;
    font('normal', 9, TEXTMUTE);
    doc.text(S(`${fecha} · Rúbrica ${raw.rubric_version}`), M_X, y);
    y += 9;

    // ===== RESUMEN =====
    section('Resumen');
    if (raw.resumen.una_linea) {
      font('bold', 11, TEXT);
      para(raw.resumen.una_linea, M_X, C_W, 5.4);
      y += 2;
    }
    const counts = countByEstado(raw.observaciones);
    // Conteos: figura + número + palabra.
    let x = M_X;
    for (const e of ESTADO_ORDEN) {
      shape(e, x + 1.6, y - 1.3);
      font('bold', 10, TEXT);
      const t = `${counts[e]} ${LABEL[e]}`;
      doc.text(S(t), x + 4.5, y);
      x += 4.5 + doc.getTextWidth(S(t)) + 8;
    }
    y += 5;
    // Barra: una celda por criterio, en el orden de los estados.
    const total = raw.observaciones.length || 1;
    const cellW = C_W / total;
    let cx = M_X;
    for (const e of ESTADO_ORDEN) {
      for (let i = 0; i < counts[e]; i++) {
        if (e === 'no_evaluable') {
          setColor('stroke', EST_COLOR[e]);
          doc.setLineWidth(0.3);
          doc.rect(cx + 0.3, y, cellW - 0.6, 3.5, 'S');
        } else {
          setColor('fill', EST_COLOR[e]);
          doc.rect(cx + 0.3, y, cellW - 0.6, 3.5, 'F');
        }
        cx += cellW;
      }
    }
    y += 8.5;
    font('normal', 9.5, TEXT);
    para(`Perfil leído: ${raw.perfil.nivel} · Apunta a: ${raw.perfil.rol_objetivo ?? 'no se distingue'}`, M_X, C_W, 4.8);
    font('italic', 8.5, TEXTMUTE);
    para('Es una lectura de tu CV contra criterios de redacción y estructura; no predice si te van a llamar.', M_X, C_W, 4.4);
    y += 4;

    // ===== QUÉ CAMBIAR PRIMERO =====
    if (raw.prioridades.length) {
      section('Qué cambiar primero');
      raw.prioridades.forEach((p, i) => {
        const o = raw.observaciones.find((ob) => ob.id === p.id_observacion);
        font('bold', 10.5, NAVY);
        const al = lines(p.accion, C_W - 12);
        needBreak(al.length * 5 + 10);
        setColor('fill', NAVY);
        doc.circle(M_X + 2.6, y - 1.4, 2.6, 'F');
        font('bold', 9, OFFW);
        doc.text(String(i + 1), M_X + 2.6, y - 0.3, { align: 'center' });
        if (o) shape(o.estado, M_X + 8, y - 1.4, 1.3);
        font('bold', 10.5, NAVY);
        al.forEach((l, k) => doc.text(l, M_X + 11, y + k * 5));
        y += al.length * 5;
        font('normal', 9.5, TEXT);
        if (p.por_que) para(`Por qué: ${p.por_que}`, M_X + 11, C_W - 11, 4.6);
        const meta = [p.esfuerzo ? `Esfuerzo: ${p.esfuerzo}` : '', o ? `Área: ${o.categoria}` : ''].filter(Boolean).join(' · ');
        if (meta) {
          font('normal', 8.5, TEXTMUTE);
          para(meta, M_X + 11, C_W - 11, 4.4);
        }
        y += 3;
      });
    }

    // ===== ASÍ SE VERÍA =====
    if (raw.reescrituras.length) {
      section('Así se vería');
      font('italic', 8.5, TEXTMUTE);
      para('Lo que va entre corchetes es un dato que solo tú tienes: complétalo o quítalo.', M_X, C_W, 4.4);
      y += 1;
      raw.reescrituras.forEach((r) => {
        font('normal', 9.5, TEXT);
        const a = lines(`"${r.antes}"`, C_W - 22);
        const d = lines(`"${r.despues}"`, C_W - 22);
        needBreak((a.length + d.length) * 4.8 + 12);
        font('bold', 8, TEXTMUTE);
        doc.text('ANTES', M_X, y);
        font('normal', 9.5, TEXT);
        a.forEach((l, k) => doc.text(l, M_X + 20, y + k * 4.8));
        y += a.length * 4.8 + 1.5;
        font('bold', 8, TEXTMUTE);
        doc.text('DESPUÉS', M_X, y);
        font('bold', 9.5, NAVY);
        d.forEach((l, k) => doc.text(l, M_X + 20, y + k * 4.8));
        y += d.length * 4.8;
        if (r.principio) {
          font('italic', 8.5, TEXTMUTE);
          para(`Por qué: ${r.principio}`, M_X + 20, C_W - 20, 4.4);
        }
        y += 4;
      });
    }

    // ===== DETALLE POR ÁREA (tabla) =====
    section('Detalle por área');
    const COL1 = 30;
    const COL2 = 44;
    const COL3 = C_W - COL1 - COL2;
    const solidos: string[] = [];
    for (const g of groupObservaciones(raw.observaciones)) {
      const rows = g.items.filter((o) => o.estado !== 'solido');
      g.items.filter((o) => o.estado === 'solido').forEach((o) => solidos.push(o.categoria));
      if (!rows.length) continue;
      needBreak(16);
      setColor('fill', BAND);
      doc.rect(M_X, y - 4, C_W, 6.2, 'F');
      font('bold', 9.5, NAVY);
      doc.text(S(g.label), M_X + 2, y);
      y += 5.5;
      for (const o of rows) {
        font('bold', 9, TEXT);
        const nameL = lines(o.categoria, COL2 - 3);
        font('normal', 9, TEXT);
        const recL = o.recomendacion ? lines(o.recomendacion, COL3) : [];
        font('normal', 8, TEXTMUTE);
        const evL = lines(o.evaluacion, COL3);
        const rowH = Math.max(nameL.length * 4.3, 4.3, recL.length * 4.4 + evL.length * 3.9) + 3;
        needBreak(rowH);
        shape(o.estado, M_X + 1.8, y - 1.2, 1.3);
        font('normal', 8.5, EST_COLOR[o.estado]);
        doc.text(S(LABEL[o.estado]), M_X + 4.5, y);
        font('bold', 9, TEXT);
        nameL.forEach((l, k) => doc.text(l, M_X + COL1, y + k * 4.3));
        let ry = y;
        font('normal', 9, TEXT);
        recL.forEach((l) => { doc.text(l, M_X + COL1 + COL2, ry); ry += 4.4; });
        font('normal', 8, TEXTMUTE);
        evL.forEach((l) => { doc.text(l, M_X + COL1 + COL2, ry); ry += 3.9; });
        y += rowH;
        setColor('stroke', RULE);
        doc.setLineWidth(0.2);
        doc.line(M_X, y - 2.2, PAGE_W - M_X, y - 2.2);
        y += 1;
      }
    }
    if (solidos.length) {
      y += 1;
      needBreak(10);
      shape('solido', M_X + 1.8, y - 1.2, 1.3);
      font('bold', 9, TEXT);
      doc.text('Sólidos:', M_X + 4.5, y);
      font('normal', 9, TEXT);
      const sl = lines(`${solidos.join(', ')}.`, C_W - 20);
      sl.forEach((l, k) => doc.text(l, M_X + 20, y + k * 4.4));
      y += sl.length * 4.4 + 4;
    }

    // ===== RETROALIMENTACIÓN GENERAL =====
    if (raw.retroalimentacion) {
      section('Retroalimentación general');
      font('normal', 10, TEXT);
      para(raw.retroalimentacion, M_X, C_W, 5);
      y += 4;
    }

    // ===== SIGUIENTE PASO (caja navy) =====
    const ns = nextStepCopy(pickNextStep(raw, lastRol), raw);
    font('normal', 10, OFFW);
    const bodyL = lines(ns.body, C_W - 12);
    const bridgeL = lines('Este análisis es general; no compara tu CV con una vacante.', C_W - 12);
    const pad = 6;
    const boxH = pad * 2 + 9 + 6 + bodyL.length * 5 + 3 + 8 + bridgeL.length * 4.4 + 4 + 10;
    needBreak(boxH + 4);
    const by = y;
    setColor('fill', NAVY_DEEP);
    doc.roundedRect(M_X, by, C_W, boxH, 2.5, 2.5, 'F');
    let cy = by + pad + 2;
    font('bold', 12, OFFW);
    doc.text('Siguiente paso sugerido', M_X + pad, cy);
    setColor('stroke', ORANGE);
    doc.setLineWidth(0.7);
    doc.line(M_X + pad, cy + 1.5, M_X + pad + doc.getTextWidth('Siguiente paso sugerido'), cy + 1.5);
    cy += 9;
    font('bold', 11, OFFW);
    doc.text(S(ns.title), M_X + pad, cy);
    cy += 6;
    font('normal', 10, OFFW);
    bodyL.forEach((l) => { doc.text(l, M_X + pad, cy); cy += 5; });
    cy += 3;
    font('bold', 10, ORANGE);
    doc.textWithLink(S(`>> ${ns.cta}`), M_X + pad, cy, { url: ns.hrefPdf });
    cy += 8;
    font('italic', 9, [200, 198, 188]);
    bridgeL.forEach((l) => { doc.text(l, M_X + pad, cy); cy += 4.4; });
    cy += 2;
    setColor('stroke', [60, 70, 95]);
    doc.setLineWidth(0.3);
    doc.line(M_X + pad, cy, PAGE_W - M_X - pad, cy);
    cy += 4.5;
    font('bold', 9, OFFW);
    doc.text(S('— Oscar Solís · Director general, Solca Ciencia y Consultoría'), M_X + pad, cy);
    y = by + boxH + 6;

    // ===== PIE en todas las páginas =====
    const totalPages = doc.internal.pages.length - 1;
    for (let i = 1; i <= totalPages; i++) {
      doc.setPage(i);
      setColor('stroke', RULE);
      doc.setLineWidth(0.2);
      doc.line(M_X, PAGE_H - 17, PAGE_W - M_X, PAGE_H - 17);
      font('normal', 7.5, TEXTMUTE);
      doc.text(S(`Solca · Ciencia y Consultoría · ${fecha} · Rúbrica ${raw.rubric_version}`), M_X, PAGE_H - 13);
      doc.text(`Página ${i} / ${totalPages}`, PAGE_W - M_X, PAGE_H - 13, { align: 'right' });
      doc.text(S('Es una lectura de tu CV contra criterios de redacción y estructura; no predice si te van a llamar.'), M_X, PAGE_H - 9.5);
    }

    return doc;
  }

  downloadBtn?.addEventListener('click', async () => {
    if (!downloadBtn || !lastResult) return;
    cvStep('report_downloaded');
    const originalText = downloadBtn.innerHTML;
    downloadBtn.disabled = true;
    downloadBtn.innerHTML =
      '<span style="display:inline-block; width:18px; height:18px; border:2.5px solid currentColor; border-top-color: transparent; border-radius:50%; animation: spin 0.9s linear infinite;"></span> Generando PDF…';
    try {
      const JsPDF = await loadJsPdf();
      const doc = generatePdf(JsPDF, lastResult);
      const date = new Date().toISOString().slice(0, 10);
      const safeName = lastResult.candidateName.replace(/[^a-zA-Z0-9áéíóúñÁÉÍÓÚÑ -]/g, '').trim().replace(/\s+/g, '-');
      const filename = `Analisis-Solca-${safeName}-${date}.pdf`;
      doc.save(filename);
    } catch (err) {
      console.error('Download PDF error', err);
      alert('No pudimos generar el PDF. Intenta de nuevo, o reporta el problema en /contacto.');
    } finally {
      downloadBtn.disabled = false;
      downloadBtn.innerHTML = originalText;
    }
  });

  retryBtn?.addEventListener('click', () => {
    hide(result);
    const formSection = document.getElementById('form');
    show(formSection);
    if (form) form.reset();
    // 6 nov 2026: el recuadro queda visible y vacío; se limpia el estado del PDF anterior.
    extract = { origen: 'pegado', paginas: null };
    setExtractMode(false);
    setUploadStatus('', 'idle');
    hide(pdfWarning);
    hide(cvError);
    updateCount();
    submitBtn && (submitBtn.disabled = false);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  errorRetryBtn?.addEventListener('click', () => {
    hide(errorSection);
    const formSection = document.getElementById('form');
    show(formSection);
    submitBtn && (submitBtn.disabled = false);
  });

  // ==================== ENCUESTA DE MERCADO (catálogo v1, 20 oct 2026) ====================
  // Reemplaza la encuesta propia del analizador. Se arranca cuando aparece el resultado;
  // el país del formulario viaja como dato derivado. Ver src/components/MarketSurvey.astro.
  if (result) {
    const marketObserver = new MutationObserver(() => {
      if (!result.hidden) {
        const country = (document.getElementById('country') as HTMLSelectElement | null)?.value;
        const market = (window as unknown as { solcaMarket?: { start: (raw: Record<string, string | undefined>) => void } }).solcaMarket;
        setTimeout(() => market?.start({ pais_label: country || undefined }), 800);
      }
    });
    marketObserver.observe(result, { attributes: true, attributeFilter: ['hidden'] });
  }

  // 6 nov 2026: la barra de compartir después del resultado se quitó (ToolShare, debajo del formulario, la reemplaza).
</script>

</BaseLayout>
