---
/**
 * /simulador-entrevistas/gracias · página post-checkout Stripe.
 *
 * Establecido: 2 sept 2026 (fase paywall).
 * v3 (11 sept 2026): muestra el código en pantalla haciendo polling al
 * endpoint /api/simulator-stripe-lookup con el session_id del URL. El
 * webhook sigue siendo la fuente de verdad; el lookup solo lee lo que ya
 * escribió el webhook (índice inverso `stripe_session:{sessionId}` → SIM-XXX).
 *
 * Ver `_docs/PAYWALL_SIMULADOR.md`.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Compra confirmada · Simulador de Entrevistas · Solca Ciencia"
  description="Tu compra se confirmó. Aquí está tu código de acceso al simulador."
  canonical="https://solcaciencia.com/simulador-entrevistas/gracias"
  noindex={true}
>
  <main class="thanks-main">
    <section class="thanks-hero">
      <div class="container">
        <div class="check-circle" aria-hidden="true">✓</div>
        <h1>Compra confirmada</h1>

        <!-- Bloque del código: aparece cuando el polling encuentra el beta code -->
        <div id="code-block" class="code-block" hidden>
          <p class="code-label">Tu código de acceso</p>
          <div class="code-wrap">
            <code id="access-code" class="access-code">—</code>
            <button type="button" id="copy-code-btn" class="copy-btn" aria-label="Copiar código">Copiar</button>
          </div>
          <p class="code-hint">
            También te enviamos una copia por email. Guarda este código: es tu llave personal al simulador.
          </p>
        </div>

        <!-- Estado de espera: mientras el webhook procesa (2-5s típico) -->
        <div id="waiting-block" class="waiting-block">
          <p class="lead">
            Estamos preparando tu código de acceso… <span class="waiting-spinner" aria-hidden="true"></span>
          </p>
          <p class="lead lead-mute">
            Toma unos segundos. Si tarda más de un minuto, revisa tu correo o escríbenos.
          </p>
        </div>

        <!-- Fallback si el polling agota timeout sin encontrar el código -->
        <div id="fallback-block" class="fallback-block" hidden>
          <p class="lead">
            El código aún se está generando. Te llegará por correo en unos minutos.
          </p>
          <p class="lead lead-mute">
            Revisa tu bandeja de entrada — y la carpeta de spam la primera vez.
          </p>
        </div>

        <div class="cta-row">
          <a id="start-btn" href="/simulador-entrevistas/sesion" class="btn btn-primary" hidden>Empezar mi primera sesión</a>
          <a href="/simulador-entrevistas/#codigo" class="btn btn-secondary" id="ingresar-btn">Ir a ingresar mi código</a>
          <a href="/simulador-entrevistas/" class="btn btn-secondary">Volver al inicio</a>
        </div>

        <p class="thanks-note">
          ¿Problemas con tu código? Escribe a
          <a href="mailto:hola@solcaciencia.com">hola@solcaciencia.com</a> con el email que usaste
          en la compra y te ayudamos.
        </p>
      </div>
    </section>
  </main>

  <script>
    // Polling al lookup hasta encontrar el código o timeout.
    // El webhook suele tardar 1-3 segundos; damos margen hasta 45s.
    (async function pollForCode() {
      const params = new URLSearchParams(location.search);
      const sessionId = params.get('session_id');
      if (!sessionId) {
        // Sin session_id (visita directa) → mostrar fallback y salir
        document.getElementById('waiting-block')?.setAttribute('hidden', '');
        document.getElementById('fallback-block')?.removeAttribute('hidden');
        return;
      }

      const MAX_ATTEMPTS = 15; // 15 × 3s = 45s máximo
      const INTERVAL_MS = 3000;
      let attempts = 0;

      async function tryOnce() {
        attempts++;
        try {
          const r = await fetch(`/api/simulator-stripe-lookup?session_id=${encodeURIComponent(sessionId)}`);
          if (r.status === 200) {
            const j = await r.json();
            if (j.ok && j.code) {
              showCode(j.code);
              return true;
            }
          }
        } catch (_e) { /* red flaky, seguir polling */ }
        return false;
      }

      // Primer intento inmediato
      if (await tryOnce()) return;
      // Polling
      const timer = setInterval(async () => {
        if (attempts >= MAX_ATTEMPTS) {
          clearInterval(timer);
          // Timeout: mostrar fallback
          document.getElementById('waiting-block')?.setAttribute('hidden', '');
          document.getElementById('fallback-block')?.removeAttribute('hidden');
          return;
        }
        if (await tryOnce()) {
          clearInterval(timer);
        }
      }, INTERVAL_MS);

      function showCode(code: string) {
        try { sessionStorage.setItem('solca_beta_code', code); } catch (_e) {}
        const codeEl = document.getElementById('access-code');
        if (codeEl) codeEl.textContent = code;
        document.getElementById('code-block')?.removeAttribute('hidden');
        document.getElementById('waiting-block')?.setAttribute('hidden', '');
        document.getElementById('start-btn')?.removeAttribute('hidden');
        document.getElementById('ingresar-btn')?.setAttribute('hidden', '');

        const copyBtn = document.getElementById('copy-code-btn') as HTMLButtonElement | null;
        if (copyBtn) {
          copyBtn.onclick = async () => {
            try {
              await navigator.clipboard.writeText(code);
              copyBtn.textContent = '✓ Copiado';
              setTimeout(() => { copyBtn.textContent = 'Copiar'; }, 2000);
            } catch (_e) { /* fallback: seleccionar texto */ }
          };
        }
      }
    })();
  </script>

  <style>
    .thanks-main {
      min-height: 60vh;
      display: flex;
      align-items: center;
      background: var(--bg, #FAF9F4);
    }
    .thanks-hero {
      width: 100%;
      padding: 80px 0;
    }
    .thanks-hero .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 0 24px;
      text-align: center;
    }
    .check-circle {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: #E77C3C;
      color: #fff;
      font-size: 32px;
      font-weight: 700;
      line-height: 64px;
      margin: 0 auto 24px;
    }
    .thanks-hero h1 {
      margin: 0 0 16px;
      font-size: 32px;
      color: #1F3A5F;
    }
    .lead {
      font-size: 17px;
      color: #111827;
      line-height: 1.5;
      margin: 0 0 12px;
    }
    .lead-mute {
      color: #4B5563;
      font-size: 15px;
    }
    .cta-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      margin: 32px 0 24px;
      flex-wrap: wrap;
    }
    .thanks-note {
      margin: 24px 0 0;
      font-size: 14px;
      color: #4B5563;
    }
    .thanks-note a {
      color: #E77C3C;
      font-weight: 600;
    }

    /* v3 (11 sept 2026) · bloque del código visible en pantalla */
    .code-block {
      margin: 24px auto;
      max-width: 480px;
      padding: 24px;
      background: #F5F5F0;
      border: 1px solid #E5E1D8;
      border-radius: 10px;
    }
    .code-label {
      margin: 0 0 12px;
      font-size: 13px;
      font-weight: 600;
      color: #4B5563;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .code-wrap {
      display: flex;
      gap: 8px;
      align-items: center;
      justify-content: center;
      margin: 0 0 16px;
    }
    .access-code {
      display: inline-block;
      padding: 12px 20px;
      background: #ffffff;
      border: 2px solid #1F3A5F;
      border-radius: 6px;
      font-family: 'SF Mono', Monaco, Consolas, monospace;
      font-size: 22px;
      font-weight: 700;
      color: #1F3A5F;
      letter-spacing: 1px;
    }
    .copy-btn {
      padding: 12px 16px;
      background: #1F3A5F;
      color: #ffffff;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
    }
    .copy-btn:hover { background: #2A4A72; }
    .code-hint {
      margin: 0;
      font-size: 13px;
      color: #6B7280;
      text-align: center;
    }
    .waiting-block, .fallback-block { margin: 24px 0; }
    .waiting-spinner {
      display: inline-block;
      width: 12px;
      height: 12px;
      border: 2px solid #E5E1D8;
      border-top-color: #1F3A5F;
      border-radius: 50%;
      animation: waiting-spin 0.8s linear infinite;
      vertical-align: middle;
      margin-left: 6px;
    }
    @keyframes waiting-spin { to { transform: rotate(360deg); } }
  </style>
</BaseLayout>
