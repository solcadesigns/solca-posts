---
/**
 * /libros/<slug> · landing por libro (23 oct 2026).
 * Contenido en src/lib/libros.ts (sale de la contraportada y el índice de cada manuscrito).
 * El botón de compra va a Hotmart; BaseLayout le agrega la etiqueta de origen (sck/src)
 * a partir del UTM de la visita y registra book_clicked. La visita se registra como page_viewed 'libro'.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { LIBROS, type Libro } from '../../lib/libros';

export const prerender = true;

export function getStaticPaths() {
  return LIBROS.map((libro) => ({ params: { slug: libro.slug }, props: { libro } }));
}

const { libro } = Astro.props as { libro: Libro };
const otros = LIBROS.filter((l) => l.slug !== libro.slug);
// Enlaces internos con ?ref= y no con UTM: un UTM interno pisaría la campaña externa guardada en la sesión.
const ref = `libro-${libro.slug}`;
const linkSimulador = `/simulador-entrevistas/?modulo=${libro.modulo}&ref=${ref}`;
const linkVacantes = `/vacantes/?rol=${libro.rol}&ref=${ref}`;
---

<BaseLayout
  title={`${libro.tituloSeo} · LATAM y España · Solca`}
  description={libro.intro}
>

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-brand"><span class="dot"></span><span>Solca</span></a>
    <div class="nav-links">
      <a href="/#libros">Libros</a>
      <a href="/vacantes">Vacantes</a>
      <a href="/simulador-entrevistas/">Simulador</a>
      <a href="/revisar-cv">Revisar CV</a>
      <a href="/contacto">Contacto</a>
    </div>
  </div>
</nav>

<section class="lb-hero">
  <div class="container lb-hero-grid">
    <div>
      <div class="eyebrow eyebrow-light"><span class="dot"></span><span>Colección Solca · Libro digital</span></div>
      <h1>{libro.titulo}</h1>
      <p class="lb-sub">{libro.subtitulo}</p>
      <p class="lb-intro">{libro.intro}</p>
      <div class="lb-ctas">
        <a href={libro.hotmart} class="btn btn-orange btn-large lb-comprar" target="_blank" rel="noopener">Comprar en Hotmart</a>
      </div>
      <p class="lb-garantia">Pago seguro en Hotmart, con garantía de 7 días: si no te sirve, pides el reembolso desde tu cuenta.</p>
    </div>
    <div class="lb-portada">
      <img src={libro.portada} alt={`Portada · ${libro.titulo}`} width="360" />
    </div>
  </div>
</section>

<section class="lb-seccion">
  <div class="container lb-angosto">
    <h2 class="section-title">Al terminarlo tendrás</h2>
    <ul class="lb-resultados">
      {libro.resultados.map((r) => <li>{r}</li>)}
    </ul>
  </div>
</section>

<section class="lb-seccion lb-alt">
  <div class="container lb-angosto">
    <h2 class="section-title">Qué hay dentro</h2>
    <p class="section-lead">Cinco módulos progresivos: del rol desde cero a tus primeros noventa días y el uso responsable de IA.</p>
    <ol class="lb-modulos">
      {libro.modulos.map((m, i) => (
        <li>
          <h3><span>Módulo {i + 1}</span>{m.titulo}</h3>
          <ul>{m.temas.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ol>
    <ul class="lb-extras">
      {libro.extras.map((e) => <li>{e}</li>)}
    </ul>
  </div>
</section>

<section class="lb-seccion">
  <div class="container lb-angosto">
    <h2 class="section-title">Para quién es</h2>
    <p>Para profesionales con formación en ciencias biológicas, biomédicas o de la salud —PhD, MD, PharmD, QFB, biología, química, biotecnología y afines— que quieren entrar a industria farmacéutica en LATAM o España. No necesitas experiencia previa en industria: el módulo 1 parte desde cero y el módulo 4 cubre tus primeros noventa días.</p>
    <p>Las cifras salariales citan su fuente pública.</p>
    <div class="lb-ctas">
      <a href={libro.hotmart} class="btn btn-orange btn-large lb-comprar" target="_blank" rel="noopener">Comprar en Hotmart</a>
    </div>
  </div>
</section>

<section class="lb-seccion lb-alt">
  <div class="container lb-angosto">
    <h2 class="section-title">Complementa la lectura</h2>
    <div class="lb-herramientas">
      <a href={linkVacantes} class="lb-herr">
        <strong>Vacantes de este rol</strong>
        <span>Ofertas abiertas en LATAM y España, tomadas de los portales de cada empresa.</span>
      </a>
      <a href={linkSimulador} class="lb-herr">
        <strong>Simulador de entrevistas</strong>
        <span>Practica con preguntas del rol y recibe un reporte de lo que tienes que reforzar.</span>
      </a>
    </div>
    <h3 class="lb-otros-tit">Otros libros de la colección</h3>
    <div class="lb-otros">
      {otros.map((o) => (
        <a href={`/libros/${o.slug}/`} class="lb-otro">
          <img src={o.portada} alt="" width="72" loading="lazy" />
          <span>{o.titulo}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="eyebrow eyebrow-light"><span class="dot"></span><span>Solca · Ciencia y Consultoría</span></div>
      <p>Acompañamiento profesional en la transición de academia a industria farmacéutica para profesionales en ciencias en LATAM y España.</p>
    </div>
    <div class="footer-links">
      <h4>Recursos</h4>
      <a href="/vacantes">Vacantes</a>
      <a href="/revisar-cv">Análisis de CV</a>
      <a href="/simulador-entrevistas/">Simulador de entrevistas</a>
      <a href="/#libros">Libros</a>
    </div>
    <div class="footer-links">
      <h4>Sitio</h4>
      <a href="/">Inicio</a>
      <a href="/contacto">Contacto</a>
      <a href="/privacidad">Privacidad</a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Oscar Omar Solís Castro · Solca · Ciencia y Consultoría. · <a href="/privacidad" style="color: inherit; text-decoration: underline;">Aviso de privacidad</a></p>
  </div>
</footer>
<div id="lb-ctx" hidden data-libro={libro.modulo}></div>
</BaseLayout>

<script is:inline>
  // Origen de la venta cuando la visita llegó desde dentro del sitio (?ref=vacantes, ?ref=home)
  // y no trae campaña externa: etiqueta "<ref>|<libro>" en sck/src (libro = pm, msl, cr, fv, consulting). Con campaña externa decide BaseLayout.
  (function () {
    try {
      var ref = new URLSearchParams(location.search).get('ref');
      var utm = window.__utm || {};
      if (!ref || utm.utm_campaign || utm.utm_source) return;
      var libro = document.getElementById('lb-ctx').dataset.libro;
      var tag = (ref.toLowerCase().replace(/[^a-z0-9-]/g, '').slice(0, 24) + '|' + libro).slice(0, 30);
      document.querySelectorAll('a.lb-comprar').forEach(function (a) {
        var u = new URL(a.href);
        u.searchParams.set(u.hostname === 'pay.hotmart.com' ? 'sck' : 'src', tag);
        a.href = u.toString();
      });
    } catch (_) {}
  })();
</script>

<style>
  .lb-hero { background: var(--navy-deep); color: var(--off-white); padding: 64px 0; }
  .lb-hero-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .lb-hero h1 { font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1; margin: 12px 0 8px; }
  .lb-sub { color: var(--orange-soft); font-weight: 600; margin: 0 0 16px; }
  .lb-intro { color: var(--off-white-mute); font-size: 1.1rem; max-width: 620px; }
  .lb-ctas { margin-top: 24px; }
  .lb-garantia { font-size: 0.9rem; color: var(--off-white-mute); margin-top: 12px; }
  .lb-portada { display: flex; justify-content: center; }
  .lb-portada img { width: 100%; max-width: 340px; height: auto; border-radius: 6px; box-shadow: 0 20px 48px rgba(0,0,0,0.35); }
  .lb-seccion { padding: 64px 0; background: var(--bg); }
  .lb-alt { background: #fff; }
  .lb-angosto { max-width: 860px; }
  .lb-resultados { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 14px; }
  .lb-resultados li { padding-left: 32px; position: relative; font-size: 1.05rem; line-height: 1.5; }
  .lb-resultados li::before { content: '✓'; position: absolute; left: 0; top: 0; color: var(--orange); font-weight: 700; }
  .lb-modulos { list-style: none; padding: 0; margin: 24px 0; display: grid; gap: 16px; }
  .lb-modulos > li { border: 1px solid var(--rule); border-radius: var(--radius); padding: 18px 22px; background: var(--bg); }
  .lb-modulos h3 { margin: 0 0 8px; font-size: 1.1rem; color: var(--navy); }
  .lb-modulos h3 span { display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--orange); margin-bottom: 2px; }
  .lb-modulos ul { margin: 0; padding-left: 18px; color: var(--text-mute); line-height: 1.6; }
  .lb-extras { display: flex; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
  .lb-extras li { background: var(--blue-soft); color: var(--navy); border-radius: 999px; padding: 6px 14px; font-size: 0.9rem; }
  .lb-herramientas { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin-top: 20px; }
  .lb-herr { display: block; border: 1px solid var(--rule); border-radius: var(--radius); padding: 18px; text-decoration: none; color: var(--text); background: var(--bg); }
  .lb-herr:hover { border-color: var(--orange); }
  .lb-herr strong { display: block; color: var(--navy); margin-bottom: 4px; }
  .lb-herr span { color: var(--text-mute); font-size: 0.95rem; }
  .lb-otros-tit { margin: 40px 0 12px; font-size: 1.05rem; color: var(--navy); }
  .lb-otros { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .lb-otro { display: flex; align-items: center; gap: 12px; text-decoration: none; color: var(--text); font-weight: 600; }
  .lb-otro img { width: 56px; height: auto; border-radius: 3px; box-shadow: var(--shadow-sm); }
  @media (max-width: 760px) {
    .lb-hero-grid { grid-template-columns: 1fr; gap: 32px; }
    .lb-portada { order: -1; }
    .lb-portada img { max-width: 200px; }
  }
</style>
