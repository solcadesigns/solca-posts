---
// Redirect 301 permanente: /simulador-entrevistas-beta/ → /simulador-entrevistas/
//
// Contexto (19 ago 2026): la landing pública canónica del simulador es ahora
// /simulador-entrevistas/. Este path se dejó vivo únicamente para no romper
// enlaces históricos de emails, materiales beta y builds cacheados.
// Preserva el query string entrante (útil para ?codigo=XYZ de emails legados).

export const prerender = false;

const url = new URL(Astro.request.url);
const target = '/simulador-entrevistas/' + (url.search ?? '');
return Astro.redirect(target, 301);
---
