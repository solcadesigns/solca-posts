---
// Redirect 301 permanente: /simulador-entrevistas-beta/sesion → /simulador-entrevistas/sesion
//
// La sesión canónica ahora vive en /simulador-entrevistas/sesion. El archivo
// original (2827 líneas) se movió a la nueva ruta. Este redirect preserva el
// query string entrante para no romper links con ?codigo= embebido.

export const prerender = false;

const url = new URL(Astro.request.url);
const target = '/simulador-entrevistas/sesion' + (url.search ?? '');
return Astro.redirect(target, 301);
---
