{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "solca",
	"main": "./dist/_worker.js/index.js",
	"compatibility_date": "2025-01-01",
	// Cron Triggers
	// Lunes 14:00 UTC = 8:00 AM CDMX (UTC-6, sin DST desde 2022).
	// Viernes 14:00 UTC = 8:00 AM CDMX. Blog broadcast semanal.
	// El handler scheduled lo inyecta scripts/patch-cron-handler.mjs
	// al final del build (post astro build, antes de wrangler deploy).
	// El handler debe rutear por controller.cron:
	//   "0 14 * * 1" → /api/simulator-weekly-cron  (digest simulador)
	//   "0 14 * * 5" → /api/blog-broadcast         (broadcast blog Vie)
	"triggers": {
		"crons": [
			"0 14 * * 1",
			"0 14 * * 5"
		]
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Variables públicas (no secretas). Los secrets van con `wrangler secret put`.
	// Usadas por /api/weekly-report para consultar Cloudflare Analytics GraphQL API.
	//   ZONE_ID: para dataset Zone Analytics (edge, incluye bots).
	//   RUM_SITE_TAG: para dataset RUM (solo humanos con JS, incluye top pages).
	//   CLOUDFLARE_ACCOUNT_TAG: contenedor de sitios RUM.
	"vars": {
		"SOLCACIENCIA_ZONE_ID": "80c71a476167b48983cfbb78e789400e",
		"SOLCACIENCIA_RUM_SITE_TAG": "c3ed59e5d60b44bc9aaaac0c95911c1f",
		"CLOUDFLARE_ACCOUNT_TAG": "187219480b04d6f4afea8aa7e6231852"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
			"binding": "CV_LIMITS",
			"id": "5fef78fd56524764925d3c597583f0ea",
			"remote": true
		},
		{
			"binding": "EMAILS",
			"id": "a4f0b989694a4872a3546beda9644846",
			"remote": true
		},
		{
			"binding": "CONTACTS",
			"id": "8692d155bc394f7aac6072ba676dab5b",
			"remote": true
		},
		{
			"binding": "QUIZ_METRICS",
			"id": "0c748230e55a45c18ff1b7c067f8ad10",
			"remote": true
		},
		{
			"binding": "CV_METRICS",
			"id": "18d5db1a26ad41d296fc67ff4ebb9c66",
			"remote": true
		},
		// Simulador de Entrevistas (Fase 1+)
		{
			"binding": "SIMULATOR_CREDITS",
			"id": "e1e4e97dd1974c95b1613e49ae7762b8",
			"remote": true
		},
		{
			"binding": "SIMULATOR_SESSIONS",
			"id": "ddb54cee43d74747b36c9e45e3b42107",
			"remote": true
		},
		{
			"binding": "SIMULATOR_METRICS",
			"id": "4f83d58215b24e0792957ff005fb2295",
			"remote": true
		},
		{
			"binding": "SIMULATOR_BETA_CODES",
			"id": "577a2b9a2247465ab88bbf6b63e3eb4a",
			"remote": true
		}
	],
	"d1_databases": [
		// Simulador · métricas estructuradas para análisis SQL
		// Crear con: npx wrangler d1 create simulator-metrics
		// Aplicar migrations: npx wrangler d1 migrations apply SIMULATOR_METRICS_DB --remote
		{
			"binding": "SIMULATOR_METRICS_DB",
			"database_name": "simulator-metrics",
			"database_id": "a72d6780-de9c-4cc0-b8da-368fdc0bc932",
			"migrations_dir": "migrations"
		}
	]
	// KV namespaces — crear con:
	//   npx wrangler kv namespace create EMAILS         (captura de emails de leads)
	//   npx wrangler kv namespace create CV_LIMITS      (rate limit · 2 análisis/30 días)
	//   npx wrangler kv namespace create CONTACTS       (mensajes del form de contacto)
	//   npx wrangler kv namespace create QUIZ_METRICS   (métricas anónimas del quiz)
	// y reemplazar el id correspondiente en este archivo.
	//
	// Secret para el endpoint /api/quiz-stats:
	//   npx wrangler secret put STATS_KEY
	//   (ingresa un valor random ~24 chars, lo usarás como ?key= en la URL)
}