# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production
.env.*.local
# Secrets locales de wrangler (STATS_KEY, GSC_*, Stripe, Postmark…).
# Agregado 21 sep 2026 al crear scripts/seo-signals.sh, que lee STATS_KEY de
# aquí. Sin esta línea, el primer `git add -A` después de crear el archivo
# subiría la llave al repo.
.dev.vars
.dev.vars.*

# macOS
.DS_Store

# editors
.vscode/
.idea/
*.swp

# build/cache
.cache/

# Office/LibreOffice lock files
.~lock.*
*~lock.*#

# Artefactos de mounts FUSE (aparecen al editar archivos en carpetas montadas)
.fuse_hidden*

# Python bytecode cache
__pycache__/
*.pyc

# Datos privados de usuarios y códigos de acceso
# (nombres, emails, códigos beta — nunca deben subirse a git)
_docs/beta-candidates*.json
_docs/beta-candidates*.csv
_docs/beta-codes*.csv
_docs/beta-outreach*.csv
_docs/private-*.json
_docs/*-privado*.json
_docs/*-privado*.csv
deploy.log
.wrangler/
_docs/~$*

# Snapshot de señales de Search Console que escribe scripts/seo-signals.sh.
# Se regenera con un comando y es data de negocio (queries, CTR por página),
# así que no se versiona. Si prefieres conservar la serie histórica para ver
# cómo evolucionan las queries, borra esta línea.
_docs/GSC_SIGNALS_LATEST.json
